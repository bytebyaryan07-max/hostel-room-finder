<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hostel & Room Finder | Online Accommodation</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <style>
        :root {
            --bg-dark: #2d2926;
            --accent-yellow: #f4c542;
            --accent-brown: #7b3f33;
            --text-light: #f8f9fa;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f4f1ea;
            color: var(--bg-dark);
            margin: 0;
        }

        h1, h2, h3, .brand-font {
            font-family: 'Playfair Display', serif;
        }

        /* --- Login / Role Selection --- */
        #login-page {
            height: 100vh;
            background-color: var(--bg-dark);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
        }

        .login-card {
            background: rgba(255, 255, 255, 0.05);
            padding: 3rem;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            text-align: center;
            max-width: 500px;
            width: 90%;
        }

        .role-btn {
            width: 100%;
            margin: 10px 0;
            padding: 12px;
            border-radius: 10px;
            font-weight: 600;
            transition: 0.3s;
        }

        /* --- Dashboard Shared Styles --- */
        .navbar {
            background-color: var(--bg-dark) !important;
        }

        .nav-link, .navbar-brand {
            color: var(--text-light) !important;
        }

        .nav-link:hover {
            color: var(--accent-yellow) !important;
        }

        .sidebar {
            background-color: var(--bg-dark);
            min-height: calc(100vh - 56px);
            color: white;
            padding: 20px;
        }

        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .btn-primary { background-color: var(--accent-brown); border: none; }
        .btn-primary:hover { background-color: #5a2e25; }
        
        .btn-warning { background-color: var(--accent-yellow); border: none; }

        /* --- Views Toggle --- */
        .view-section { display: none; }
        .active-view { display: block; }

        .status-badge {
            font-size: 0.8rem;
            padding: 5px 10px;
            border-radius: 20px;
        }
    </style>
</head>
<body>

<!-- ================= LOGIN / ROLE SELECTION ================= -->
<section id="login-page" class="active-view">
    <div class="login-card">
        <div class="mb-4">
            <i class="bi bi-house-door-fill text-warning" style="font-size: 3rem;"></i>
        </div>
        <h1 class="mb-2">Hostel & Room Finder</h1>
        <p class="text-secondary mb-4">Please select your role to continue</p>
        
        <button class="btn btn-warning role-btn" onclick="showDashboard('student-view')">
            <i class="bi bi-person-badge me-2"></i> Student Login
        </button>
        <button class="btn btn-outline-light role-btn" onclick="showDashboard('owner-view')">
            <i class="bi bi-house-gear me-2"></i> Owner / Landlord Login
        </button>
        <button class="btn btn-outline-secondary role-btn" onclick="showDashboard('admin-view')">
            <i class="bi bi-shield-lock me-2"></i> Administrator Login
        </button>
    </div>
</section>

<!-- ================= STUDENT VIEW ================= -->
<section id="student-view" class="view-section">
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand brand-font" href="#"><i class="bi bi-house-door-fill text-warning"></i> RoomFinder</a>
            <button class="btn btn-sm btn-outline-light ms-auto" onclick="logout()">Logout</button>
        </div>
    </nav>

    <header class="bg-dark text-white py-5 text-center" style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1555854877-bab0e564b8d5?auto=format&fit=crop&q=80&w=1000'); background-size: cover;">
        <div class="container py-4">
            <h1 class="display-4 fw-bold">Find your home away from home.</h1>
            <p class="lead">Search for hostels and PGs near your college.</p>
            <div class="row justify-content-center mt-4">
                <div class="col-md-8">
                    <div class="input-group input-group-lg shadow">
                        <input type="text" class="form-control" placeholder="Enter College Name or Area...">
                        <button class="btn btn-warning px-4" type="button">Search</button>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="container my-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="brand-font">Featured Accommodations</h3>
            <div class="dropdown">
                <button class="btn btn-outline-dark dropdown-toggle" data-bs-toggle="dropdown">Filter by Price</button>
            </div>
        </div>
        <div class="row g-4">
            <!-- Property Card 1 -->
            <div class="col-md-4">
                <div class="card h-100">
                    <img src="https://images.unsplash.com/photo-1595526114035-0d45ed16cfbf?auto=format&fit=crop&q=80&w=500" class="card-img-top" alt="Room">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">Sunshine Boys Hostel</h5>
                        <p class="text-muted mb-2"><i class="bi bi-geo-alt"></i> 0.5km from University Gate</p>
                        <p class="card-text small">WiFi, AC, Laundry, 3-time meals included.</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="h5 mb-0 text-primary">₹8,500<small>/mo</small></span>
                            <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#inquiryModal">View Details</button>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Property Card 2 -->
            <div class="col-md-4">
                <div class="card h-100">
                    <img src="https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?auto=format&fit=crop&q=80&w=500" class="card-img-top" alt="Room">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">Royal Girls PG</h5>
                        <p class="text-muted mb-2"><i class="bi bi-geo-alt"></i> 1.2km from Engineering College</p>
                        <p class="card-text small">Attached Washroom, 24/7 Security, Shared Kitchen.</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="h5 mb-0 text-primary">₹6,000<small>/mo</small></span>
                            <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#inquiryModal">View Details</button>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Property Card 3 -->
            <div class="col-md-4">
                <div class="card h-100">
                    <img src="https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&q=80&w=500" class="card-img-top" alt="Room">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">Elite Shared Rooms</h5>
                        <p class="text-muted mb-2"><i class="bi bi-geo-alt"></i> Near Central Library</p>
                        <p class="card-text small">Best for medical students, quiet environment.</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="h5 mb-0 text-primary">₹10,200<small>/mo</small></span>
                            <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#inquiryModal">View Details</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= OWNER VIEW ================= -->
<section id="owner-view" class="view-section">
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand brand-font" href="#"><i class="bi bi-house-door-fill text-warning"></i> Owner Dashboard</a>
            <button class="btn btn-sm btn-outline-light ms-auto" onclick="logout()">Logout</button>
        </div>
    </nav>
    <div class="container mt-4">
        <div class="row">
            <div class="col-md-3">
                <div class="sidebar rounded">
                    <h5 class="mb-4">Welcome, Aryan Linge</h5>
                    <ul class="nav flex-column">
                        <li class="nav-item mb-2"><a href="#" class="nav-link bg-secondary rounded text-white active"><i class="bi bi-grid-1x2 me-2"></i> My Properties</a></li>
                        <li class="nav-item mb-2"><a href="#" class="nav-link"><i class="bi bi-chat-dots me-2"></i> Inquiries <span class="badge bg-danger">3</span></a></li>
                        <li class="nav-item mb-2"><a href="#" class="nav-link"><i class="bi bi-person me-2"></i> Profile Settings</a></li>
                    </ul>
                </div>
            </div>
            <div class="col-md-9">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3>Manage Listings</h3>
                    <button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#addPropertyModal"><i class="bi bi-plus-lg"></i> Add New Property</button>
                </div>
                <div class="card p-3 mb-3">
                    <div class="row align-items-center">
                        <div class="col-auto"><img src="https://images.unsplash.com/photo-1595526114035-0d45ed16cfbf?auto=format&fit=crop&q=80&w=100" class="rounded" alt="thumb"></div>
                        <div class="col">
                            <h6 class="mb-0 fw-bold">Sunshine Boys Hostel</h6>
                            <small class="text-muted">Listed on: 12 Oct 2023</small>
                        </div>
                        <div class="col text-center">
                            <span class="status-badge bg-success-subtle text-success">Verified</span>
                        </div>
                        <div class="col text-end">
                            <button class="btn btn-sm btn-outline-dark me-2">Edit</button>
                            <button class="btn btn-sm btn-outline-danger">Remove</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= ADMIN VIEW ================= -->
<section id="admin-view" class="view-section">
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <span class="navbar-brand brand-font"><i class="bi bi-shield-lock text-warning"></i> Admin Portal</span>
            <button class="btn btn-sm btn-outline-light" onclick="logout()">Logout</button>
        </div>
    </nav>
    <div class="container mt-5">
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-center p-3 bg-white">
                    <h2 class="fw-bold">128</h2>
                    <p class="text-muted mb-0">Total Listings</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center p-3 bg-white">
                    <h2 class="fw-bold text-danger">5</h2>
                    <p class="text-muted mb-0">Pending Verification</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center p-3 bg-white">
                    <h2 class="fw-bold text-success">450</h2>
                    <p class="text-muted mb-0">Registered Students</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center p-3 bg-white">
                    <h2 class="fw-bold text-primary">82</h2>
                    <p class="text-muted mb-0">Active Owners</p>
                </div>
            </div>
        </div>

        <h4 class="mb-3">Pending Approval Requests</h4>
        <div class="table-responsive bg-white rounded shadow-sm p-3">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Property Name</th>
                        <th>Owner</th>
                        <th>Location</th>
                        <th>Submitted Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Green View PG</strong></td>
                        <td>Ojas Yadav</td>
                        <td>Near City Mall</td>
                        <td>24 Oct 2023</td>
                        <td>
                            <button class="btn btn-sm btn-success">Approve</button>
                            <button class="btn btn-sm btn-danger">Reject</button>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>Skyline Accommodations</strong></td>
                        <td>Shreyash Kakad</td>
                        <td>West Campus</td>
                        <td>25 Oct 2023</td>
                        <td>
                            <button class="btn btn-sm btn-success">Approve</button>
                            <button class="btn btn-sm btn-danger">Reject</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- Modal: Student Inquiry -->
<div class="modal fade" id="inquiryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Property Details & Inquiry</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p><strong>Contact Owner:</strong> +91 98765 43210</p>
                <form>
                    <div class="mb-3">
                        <label class="form-label">Your Message</label>
                        <textarea class="form-control" rows="3" placeholder="Hi, I am interested in this room..."></textarea>
                    </div>
                    <button type="button" class="btn btn-warning w-100" onclick="alert('Inquiry Sent Successfully!')" data-bs-dismiss="modal">Send Inquiry</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Owner Add Property -->
<div class="modal fade" id="addPropertyModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">List Your Property</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Hostel Name</label>
                        <input type="text" class="form-control">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Monthly Rent (₹)</label>
                        <input type="number" class="form-control">
                    </div>
                    <div class="col-12">
                        <label class="form-label">Full Address</label>
                        <textarea class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Accommodation Type</label>
                        <select class="form-select">
                            <option>Hostel (Boys)</option>
                            <option>Hostel (Girls)</option>
                            <option>Private Room (PG)</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Upload Photos</label>
                        <input type="file" class="form-control">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" onclick="alert('Submitted for Admin Verification!')" data-bs-dismiss="modal">Submit Listing</button>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap 5 JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // Simple logic to switch between views
    function showDashboard(viewId) {
        // Hide all views
        document.querySelectorAll('section').forEach(section => {
            section.classList.remove('active-view');
            section.style.display = 'none';
        });

        // Show selected view
        const target = document.getElementById(viewId);
        target.classList.add('active-view');
        target.style.display = 'block';
        
        // Scroll to top
        window.scrollTo(0, 0);
    }

    function logout() {
        showDashboard('login-page');
    }
</script>

</body>
</html>
